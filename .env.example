# Copy to `.env` and fill in your Tinybird credentials.
# Tinybird ClickHouse-interface host for your region. Examples:
#   clickhouse.us-east.aws.tinybird.co (AWS, us-east)
#   clickhouse.us-west-2.aws.tinybird.co (AWS, us-west-2)
#   clickhouse.eu-central-1.aws.tinybird.co (AWS, eu-central-1)
#   clickhouse.eu-west-1.aws.tinybird.co (AWS, eu-west-1)
#   clickhouse.ap-east-1.aws.tinybird.co (AWS, ap-east-1)
#   clickhouse.ap-southeast-2.aws.tinybird.co (AWS, ap-southeast-2)
#   clickhouse.tinybird.co (GCP, europe-west3)
#   clickhouse.us-east.tinybird.co (GCP, us-east4)
#   clickhouse.europe-west2.gcp.tinybird.co (GCP, europe-west2)
#   clickhouse.northamerica-northeast2.gcp.tinybird.co (GCP, northamerica-northeast2)
TB_HOST=clickhouse.us-east.aws.tinybird.co

# Workspace name (lower-case, no slashes). This is informational on the
# Tinybird side because routing is driven by the token, but pg_clickhouse
# still requires a `dbname` for the FDW. Use the workspace name.
TB_WORKSPACE=my_workspace

# Any Tinybird token with read scope over the resources you want to query.
# An admin token works for the PoC. Treat this like a password.
TB_TOKEN=p.eyJ1...replace_me

# Local Postgres credentials (only used to log in to the bridge container).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tinybird_bridge
POSTGRES_PORT=5432
